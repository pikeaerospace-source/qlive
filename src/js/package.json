{
  "name": "qlive",
  "version": "0.1.0",
  "description": "Decentralized live streaming protocol for the Qortal network",
  "type": "module",
  "license": "MIT",
  "author": "Mike Sharkey <mike@pikeaero.com>",
  "keywords": [
    "qortal",
    "live-streaming",
    "p2p",
    "decentralized",
    "video",
    "webrtc"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}