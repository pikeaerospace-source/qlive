# EditorConfig — cross-editor style consistency
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------- Markdown ----------
[*.md]
trim_trailing_whitespace = false

# ---------- JavaScript / TypeScript ----------
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# ---------- JSON ----------
[*.{json,jsonc,json5}]
indent_size = 2

# ---------- YAML ----------
[*.{yml,yaml}]
indent_size = 2

# ---------- Python ----------
[*.py]
indent_size = 4
max_line_length = 100

# ---------- Java ----------
[*.java]
indent_size = 4
max_line_length = 100

# ---------- Shell ----------
[*.{sh,bash,zsh}]
indent_size = 2

# ---------- Makefile ----------
[Makefile]
indent_style = tab

# ---------- Docker ----------
[Dockerfile]
indent_size = 4